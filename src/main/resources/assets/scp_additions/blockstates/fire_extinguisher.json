{
  "multipart": [
    {
      "when": {"facing": "north"},
      "apply": {"model": "scp_additions:block/extinguisher"}
    },
    {
      "when": {"facing": "north"},
      "apply": {"model": "scp_additions:block/extinguisher_glass"}
    },
    {
      "when": {"facing": "east"},
      "apply": {"model": "scp_additions:block/extinguisher", "y": 90}
    },
    {
      "when": {"facing": "east"},
      "apply": {"model": "scp_additions:block/extinguisher_glass", "y": 90}
    },
    {
      "when": {"facing": "south"},
      "apply": {"model": "scp_additions:block/extinguisher", "y": 180}
    },
    {
      "when": {"facing": "south"},
      "apply": {"model": "scp_additions:block/extinguisher_glass", "y": 180}
    },
    {
      "when": {"facing": "west"},
      "apply": {"model": "scp_additions:block/extinguisher", "y": 270}
    },
    {
      "when": {"facing": "west"},
      "apply": {"model": "scp_additions:block/extinguisher_glass", "y": 270}
    }
  ]
}
